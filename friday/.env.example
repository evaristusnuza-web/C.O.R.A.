# Required for chat. Create an API key with your chosen OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: set this for a compatible provider or a local server such as Ollama.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1

ASSISTANT_NAME=Friday
USER_NAME=
# Optional. Defaults to friday/data/friday.sqlite3.
# FRIDAY_DB_PATH=/absolute/path/to/friday.sqlite3

# ElevenLabs voice transcription (Scribe) and spoken replies.
ELEVENLABS_API_KEY=
# Required for generated voice replies. Find a voice ID in your ElevenLabs account.
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Optional Gmail sending. Friday creates drafts; sending always requires a click in the app.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# Optional: expose extra tools (for example Spotify workflows) from an n8n MCP SSE endpoint.
# N8N_MCP_SERVER_URL=https://your-n8n-host.example/mcp/sse
# N8N_MCP_SERVER_TOKEN=
